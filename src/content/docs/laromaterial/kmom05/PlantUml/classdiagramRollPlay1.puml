@startuml

class Character {
    - _name: string
    - _level: int
    - _health: int

    + Attack(): void
    + TakeDamage(damage: int): void
}

class Warrior {
    - _armor: int

    + Warrior(name: string)
    + GetArmor(): int
    + ShieldBlock(): void
}

class Mage {
    - _mana: int

    + Mage(name: string)
    + GetMana(): int
    + CastSpell(): void
}

class Archer {
    - _arrows: int

    + Archer(name: string)
    + GetArrows(): int
    + ShootArrow(): void
}

Character <|-- Warrior
Character <|-- Mage
Character <|-- Archer

@enduml
